{
  "name": "crimetracker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Crime Tracker — a futuristic public-safety incident visualization system.",
  "workspaces": [
    "shared",
    "server",
    "web"
  ],
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "concurrently -n SERVER,WEB -c cyan,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "npm run dev --workspace server",
    "dev:web": "npm run dev --workspace web",
    "build": "npm run build --workspace shared && npm run build --workspace server && npm run build --workspace web",
    "start": "npm run start --workspace server",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b shared server web",
    "prepare:geo": "node scripts/prepare-geo.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "pino-pretty": "^13.1.3",
    "playwright": "^1.63.0",
    "topojson-client": "^3.1.0",
    "typescript": "^5.7.3",
    "us-atlas": "^3.0.1",
    "vitest": "^3.0.5"
  }
}
