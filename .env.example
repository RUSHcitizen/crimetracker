# ---------------------------------------------------------------------------
# Crime Tracker — server environment.
# Copy to `.env` and edit. Never commit `.env`. No key here is exposed to the
# browser: the frontend only ever talks to this server.
# ---------------------------------------------------------------------------

# --- server ---------------------------------------------------------------
PORT=8787
HOST=127.0.0.1
# Comma-separated origins allowed to call the API (dev vite server by default).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- storage --------------------------------------------------------------
# Path to the SQLite file. A relative path is resolved against the repository
# root, not the working directory, so it points at the same file however the
# server is started. Use ":memory:" for an ephemeral run.
DATABASE_PATH=./data/crimetracker.db
# Incidents older than this are pruned on startup (0 disables pruning).
RETENTION_HOURS=168

# --- mode -----------------------------------------------------------------
# "simulation" (default) or "live". Live mode only emits incidents from
# configured real sources; it never falls back to simulated data.
MODE=simulation

# --- simulation -----------------------------------------------------------
# Mean seconds between simulated incidents (lower = busier).
SIM_INTERVAL_SECONDS=20
# Deterministic runs for demos/tests. Leave empty for a random seed.
SIM_SEED=
# Number of historical incidents backfilled at startup so the map is populated.
SIM_BACKFILL=2400
# Hours of history the backfill spans.
SIM_BACKFILL_HOURS=12

# --- real public-safety data ----------------------------------------------
# Catalogued live feeds to run, comma separated. These are real datasets
# published by the agencies themselves. Run `npm run sources` to list them and
# `npm run probe:source -- <id>` to check a mapping against live data.
#
#   seattle-fire-911       Seattle Fire 911 dispatch   (live, minutes behind)
#   seattle-police-calls   SPD calls for service       (hours behind, blurred to block)
#   seattle-crime-reports  SPD offence reports         (days behind, revised)
#
# LIVE mode runs only these. Simulation is stopped while live mode is active.
SOURCES=

# --- generic feed (for a source not in the catalogue) ----------------------
# Must be a publicly accessible https:// endpoint returning JSON or GeoJSON.
# Only use feeds whose terms permit this use. Respect their rate limits.
FEED_URL=
FEED_NAME=Public Safety Feed
FEED_POLL_SECONDS=60
# Dot-path to the array of records inside the response (blank = response is the
# array, or a GeoJSON FeatureCollection which is detected automatically).
FEED_ITEMS_PATH=
# Dot-paths mapping feed records onto the incident model.
FEED_MAP_ID=id
FEED_MAP_TIMESTAMP=timestamp
FEED_MAP_TYPE=type
FEED_MAP_DESCRIPTION=description
FEED_MAP_LOCATION=address
FEED_MAP_LAT=latitude
FEED_MAP_LON=longitude

# --- AI extraction (optional, off unless AI_PROVIDER is set) ---------------
# "heuristic" (default, local, no network) | "openai-compatible"
AI_PROVIDER=heuristic
# Any OpenAI-compatible endpoint: OpenAI, Ollama, vLLM, LM Studio, ...
#   OpenAI : https://api.openai.com/v1
#   Ollama : http://127.0.0.1:11434/v1
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=
AI_TIMEOUT_MS=15000

# --- optional public-audio pipeline (police radio) ------------------------
# Disabled unless BOTH a public stream URL and the acknowledgement are set.
#
# Read this before enabling it. Most large Washington agencies — including
# Seattle PD and King County — now encrypt their primary dispatch channels.
# Encrypted traffic is out of scope permanently: this project will not decode
# it, and there is no setting that makes it try. What remains available is
# whatever an agency still broadcasts in the clear.
#
# Point this only at audio you are permitted to process. Aggregator sites
# generally forbid automated capture in their terms; an archive API you have
# access to, or your own receiver, is the usual lawful route.
# Never at encrypted, restricted or private channels.
PUBLIC_AUDIO_URL=
PUBLIC_AUDIO_ACK=0
PUBLIC_AUDIO_SEGMENT_SECONDS=30
# Speech-to-text provider: "null" (no-op) | "whisper-http" (OpenAI-compatible
# /audio/transcriptions endpoint, e.g. openai or a local whisper server)
STT_PROVIDER=null
STT_BASE_URL=
STT_MODEL=whisper-1
STT_API_KEY=

# --- pattern detection ----------------------------------------------------
PATTERN_WINDOW_MINUTES=45
PATTERN_EPS_KM=0.9
PATTERN_MIN_POINTS=5
