{
  // Lives at the repository root on purpose.
  //
  // This repo is an npm workspace, and the Worker is its single deployable unit.
  // Cloudflare Workers Builds runs `npx wrangler deploy` from the repository root; with
  // the config nested under `worker/`, wrangler finds no config there, falls back to
  // auto-detection, sees a workspace root and refuses with "run in the root of a
  // workspace instead of targeting a specific project". Keeping the config here means
  // the default build and deploy commands work with no dashboard configuration.
  //
  // `main` and `assets.directory` are resolved relative to this file.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "crimetracker",
  "main": "worker/src/index.ts",
  "compatibility_date": "2025-01-15",
  "compatibility_flags": ["nodejs_compat"],

  // The built client is served straight from the Worker, so the API, the WebSocket and
  // the page are all same-origin — no CORS, and no second deployment to keep in step.
  "assets": {
    "directory": "web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },

  "durable_objects": {
    "bindings": [{ "name": "TRACKER", "class_name": "TrackerRoom" }]
  },

  // `new_sqlite_classes` gives the Durable Object an embedded SQLite database, which is
  // what the incident store runs on.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["TrackerRoom"] }],

  "observability": { "enabled": true },

  // The Durable Object drives itself with alarms, which survive eviction. This cron is
  // belt-and-braces: it nudges the room awake if it has been idle with no alarm pending
  // and no client connected.
  "triggers": { "crons": ["*/5 * * * *"] },

  "vars": {
    "MODE": "simulation",
    "SIM_INTERVAL_SECONDS": "20",
    "SIM_BACKFILL": "2400",
    "SIM_BACKFILL_HOURS": "12",
    "RETENTION_HOURS": "168",
    "PATTERN_WINDOW_MINUTES": "45",
    "PATTERN_EPS_KM": "0.9",
    "PATTERN_MIN_POINTS": "5"
  }
}
