{
  // SPACE RADAR deploys as a single Cloudflare Worker: the prerendered page and every
  // static asset are served from `dist`, and the /api routes run in the same Worker so
  // upstream API keys never reach the client.
  //
  //   npm run deploy
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "spacesight",
  "main": "./dist/_worker.js/index.js",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  // Wrangler runs this before `deploy` and `dev`.
  //
  // It is here, rather than only in a CI dashboard field, because `wrangler deploy` on its
  // own cannot produce `main` — the Astro adapter generates dist/_worker.js during the
  // build. A build host that installs dependencies and then goes straight to the deploy
  // command will always fail with "entry-point file not found", and the fix being a
  // setting in a web form makes it invisible to anyone reading this repository. With the
  // command declared here, `npx wrangler deploy` is self-sufficient anywhere.
  "build": {
    "command": "npm run build"
  },

  "observability": { "enabled": true },

  "vars": {
    // Upstreams that need no credential at all. Left here so a fork can point them at a
    // mirror without touching code.
    "HORIZONS_URL": "https://ssd.jpl.nasa.gov/api/horizons.api",
    "SBDB_CAD_URL": "https://ssd-api.jpl.nasa.gov/cad.api",
    "CELESTRAK_GP_URL": "https://celestrak.org/NORAD/elements/gp.php",
    "SWPC_BASE_URL": "https://services.swpc.noaa.gov"
  }

  // Secrets (never vars, never client-side):
  //   npx wrangler secret put NASA_API_KEY     # optional; api.nasa.gov, DEMO_KEY if unset
  // The client never sees these — it only ever talks to this Worker's /api routes.
}
